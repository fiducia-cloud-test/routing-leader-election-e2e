{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fiducia-routing-leader-election-acceptance",
  "main": "./rpc-worker.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "COORDINATOR", "class_name": "FiduciaLeaseCoordinator" }]
  },
  "exports": {
    "FiduciaLeaseCoordinator": { "type": "durable-object", "storage": "sqlite" }
  }
}
